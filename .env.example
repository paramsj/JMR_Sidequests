# Environment variables for Topic Modelling — Agentic AI
# Copy this file to .env and add your actual values
# ⚠️ Never commit real .env files to version control!

# Mistral AI API key (required for LLM operations)
# Set this in your environment or HuggingFace Spaces secrets
# Example: export MISTRAL_API_KEY="your-key-here"
MISTRAL_API_KEY=

# Optional: Gradio space deployment settings
# These are typically set by the hosting platform
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SSR_MODE=False